<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FEFEFE">

    <!-- 강아지 정보 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/dog_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/pagination_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 강아지 이미지 -->
            <ImageView
                android:id="@+id/dog_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/jonny"
                android:scaleType="centerCrop"
                android:contentDescription="강아지 이미지" />

            <!-- 프로필 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- 프로필 사진과 소개 -->
                <!-- 팔로우, 메시지 버튼 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- 프로필 사진 -->
                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/rounded_image_background"
                        android:clipToOutline="true"
                        android:contentDescription="프로필 사진"
                        android:scaleType="centerCrop"
                        android:src="@drawable/jonny" />

                    <!-- 이름과 성별 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/dog_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="조니"
                            android:textColor="#121212"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="성별"
                            android:src="@drawable/ic_male" />

                    </LinearLayout>

                    <!-- 한줄 소개 -->
                    <TextView
                        android:id="@+id/dog_intro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="안녕하세요! 달리기 좋아하는 3살 조니예요 :)"
                        android:textColor="#808080"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- 팔로우 버튼 -->
                    <TextView
                        android:id="@+id/follow_button"
                        android:layout_width="100dp"
                        android:layout_height="32dp"
                        android:background="@drawable/rounded_button_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="팔로우"
                        android:textColor="#FEFEFE"
                        android:textSize="14sp" />

                    <!-- 메시지 버튼 -->
                    <TextView
                        android:id="@+id/message_button"
                        android:layout_width="100dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/rounded_button_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="메시지"
                        android:textColor="#15AB6C"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- 상세 정보 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="79dp"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- 나이 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="17dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="나이"
                            android:textColor="#808080"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dog_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="3년 6개월"
                            android:textColor="#4F4F4F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- 견종 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="17dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="견종"
                            android:textColor="#808080"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dog_breed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="래브라도 리트리버"
                            android:textColor="#4F4F4F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- 분류 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="17dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="분류"
                            android:textColor="#808080"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dog_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="대형견"
                            android:textColor="#4F4F4F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/menu_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="메뉴" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- 페이지네이션 인디케이터 -->
    <LinearLayout
        android:id="@+id/pagination_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/indicator_0"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_indicator_active"
            android:contentDescription="페이지 1" />

        <ImageView
            android:id="@+id/indicator_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_indicator_inactive"
            android:contentDescription="페이지 2" />

        <ImageView
            android:id="@+id/indicator_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_indicator_inactive"
            android:contentDescription="페이지 3" />

        <ImageView
            android:id="@+id/indicator_3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_indicator_inactive"
            android:contentDescription="페이지 4" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 