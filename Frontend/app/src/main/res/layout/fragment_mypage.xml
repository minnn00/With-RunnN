<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 마이페이지 타이틀 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        >

        <TextView
            android:id="@+id/text_title_mypage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:fontFamily="@font/pretendard_semibold"
            android:text="마이페이지"
            android:textColor="#121212"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/setting_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="18dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_setting"
            android:clickable="true"
            android:focusable="true"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 상단 프로필 정보 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="1dp"
        android:padding="20dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp">

            <!-- 프로필 이미지 -->
            <ImageView
                android:id="@+id/image_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle"
                android:clipToOutline="true"
                android:scaleType="centerInside"
                android:src="@drawable/logo" />

            <!-- 연필 아이콘 (오른쪽 아래에 겹치게) -->
            <ImageView
                android:id="@+id/btn_edit_profile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_edit_circle"
                android:padding="4dp"
                android:src="@drawable/pen"
                android:scaleType="centerInside" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="199dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보리"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="#000000" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <!-- 팔로워 -->
                <LinearLayout
                    android:id="@+id/layout_follower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true">
                    <TextView
                        android:id="@+id/text_follower_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="팔로워"
                        android:textSize="12sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:textColor="@color/gray_950"
                        android:layout_marginEnd="9dp"/>

                    <TextView
                        android:id="@+id/text_follower_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="32"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_medium"
                        android:textColor="@color/gray_950"
                        android:layout_marginEnd="24dp" />
                </LinearLayout>

                <!-- 팔로잉 -->
                <LinearLayout
                    android:id="@+id/layout_following"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true">
                    <TextView
                        android:id="@+id/text_following_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="팔로잉"
                        android:textSize="12sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:textColor="@color/gray_950"
                        android:layout_marginEnd="9dp"/>

                    <TextView
                        android:id="@+id/text_following_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="86"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_medium"
                        android:textColor="@color/gray_950"
                        android:layout_marginEnd="24dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <!-- 첫 줄 : 정보 + 도형 구분 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvMetaAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1년 3개월"
                        android:textSize="12sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:textColor="@color/gray_500" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="9dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/rectangle" />

                    <TextView
                        android:id="@+id/tvMetaBreed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="래브라도 리트리버"
                        android:textSize="12sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:textColor="@color/gray_500" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="9dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/rectangle" />

                    <TextView
                        android:id="@+id/tvMetaSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="대형견"
                        android:textSize="12sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:textColor="@color/gray_500" />
                </LinearLayout>

                <!--  두 번째 줄 : 성격 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="# 성격"
                        android:textColor="@color/gray_850"
                        android:textSize="12sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:background="@drawable/bg_tag_label"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvCharMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="에너지 폭발"
                        android:textColor="@color/green_700"
                        android:fontFamily="@font/pretendard_medium"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvCharMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="외 2개"
                        android:textColor="@color/gray_750"
                        android:fontFamily="@font/pretendard_regular"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 세 번째 줄 : 산책 스타일 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="# 산책 스타일"
                        android:textColor="@color/gray_850"
                        android:textSize="12sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:background="@drawable/bg_tag_label"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvStyleMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="속도 균형"
                        android:textColor="@color/green_700"
                        android:fontFamily="@font/pretendard_medium"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvStyleMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="외 2개"
                        android:textColor="@color/gray_750"
                        android:textSize="12sp"
                        android:fontFamily="@font/pretendard_regular"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 산책 함께 문구 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginVertical="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_slogan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="저랑 같이 산책해요 🐶"
            android:fontFamily="@font/pretendard_regular"
            android:textSize="13sp"
            android:textColor="@color/gray_950" />
    </LinearLayout>

    <!-- 탭 메뉴 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabIndicatorColor="@color/green_700"
        app:tabSelectedTextColor="@color/gray_950"
        app:tabTextColor="@color/gray_400"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabGravity="fill">


    </com.google.android.material.tabs.TabLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mypage_rcv"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"/>

</LinearLayout>
