<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <!-- 프로필 이미지 -->
    <ImageView
        android:id="@+id/friend_profile_image"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:src="@drawable/ellipse_50"
        android:scaleType="centerCrop"
        android:background="@drawable/circular_image_background"
        android:clipToOutline="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 선택 시 초록색 보더 오버레이 (이미지 위를 감싸도록 오버레이로 배치) -->
    <View
        android:id="@+id/friend_profile_border"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:background="@drawable/circular_image_background_selected"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/friend_profile_image"
        app:layout_constraintStart_toStartOf="@id/friend_profile_image"
        app:layout_constraintEnd_toEndOf="@id/friend_profile_image"
        app:layout_constraintBottom_toBottomOf="@id/friend_profile_image" />

    <!-- 선택 체크 아이콘 (우하단) -->
    <ImageView
        android:id="@+id/friend_check_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_check_active"
        android:contentDescription="선택됨"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/friend_profile_image"
        app:layout_constraintEnd_toEndOf="@id/friend_profile_image"
        android:layout_marginBottom="-2dp"
        android:layout_marginEnd="-2dp" />

    <!-- 친구 이름 -->
    <TextView
        android:id="@+id/friend_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="마루"
        android:textSize="13sp"
        android:textColor="#4f4f4f"
        android:fontFamily="@font/pretendard_medium"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/friend_profile_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- 체크박스 (초기에는 숨김) -->
    <CheckBox
        android:id="@+id/friend_checkbox"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@drawable/circle_checkbox_background"
        android:button="@null"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/friend_profile_image"
        app:layout_constraintEnd_toEndOf="@id/friend_profile_image"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout> 