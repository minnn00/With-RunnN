<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#802F2F2F">

    <!-- 채팅방 이름 설정 다이얼로그 -->
    <androidx.cardview.widget.CardView
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FEFEFE"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- 제목 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="채팅방 이름 설정"
                android:textColor="#222222"
                android:textSize="18sp"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:paddingTop="24dp" />

            <!-- 입력 필드 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/chat_room_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_entry_inactive_rounded"
                    android:hint="채팅방 이름을 입력하세요"
                    android:textColor="#222222"
                    android:textColorHint="#808080"
                    android:textSize="14sp"
                    android:fontFamily="@font/pretendard_medium"
                    android:padding="16dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionDone" />

                <!-- X 버튼 (초기에는 숨김) -->
                <ImageView
                    android:id="@+id/clear_button"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_cross"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- 설정 버튼 -->
            <TextView
                android:id="@+id/set_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_inactive"
                android:text="설정"
                android:textColor="#808080"
                android:textSize="16sp"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout> 