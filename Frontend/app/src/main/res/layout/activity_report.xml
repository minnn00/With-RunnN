<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FEFEFE">

    <!-- 상단바 -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 뒤로가기 버튼 -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="뒤로가기"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <!-- 제목 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="신고하기"
            android:textColor="#121212"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center" />

        <!-- 빈 공간 (제목 중앙 정렬을 위해) -->
        <View
            android:layout_width="32dp"
            android:layout_height="32dp" />

    </LinearLayout>

    <!-- 신고 이유 작성 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="36dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/tab_bar"
        app:layout_constraintBottom_toTopOf="@id/submit_button">

        <!-- 제목과 설명 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="신고하시는 이유를 작성해주세요"
                android:textColor="#121212"
                android:textSize="16sp"
                android:fontFamily="@font/pretendard_medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="원활한 이용을 위해 검토 후 서비스 이용을 제한할 예정입니다."
                android:textColor="#808080"
                android:textSize="12sp"
                android:fontFamily="@font/pretendard_regular" />

        </LinearLayout>

        <!-- 텍스트 입력 필드 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="146dp">

            <EditText
                android:id="@+id/report_edit_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_entry_inactive"
                android:hint="텍스트를 입력해주세요"
                android:textColorHint="#A4A4A4"
                android:textColor="#121212"
                android:textSize="12sp"
                android:fontFamily="@font/pretendard_regular"
                android:padding="20dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:maxLength="300" />

            <!-- 글자 수 표시 -->
            <TextView
                android:id="@+id/character_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="20dp"
                android:text="0/300"
                android:textColor="#A4A4A4"
                android:textSize="12sp"
                android:fontFamily="@font/pretendard_regular"
                android:letterSpacing="0.3" />

        </FrameLayout>

    </LinearLayout>

    <!-- 제출하기 버튼 -->
    <TextView
        android:id="@+id/submit_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_button_inactive"
        android:text="제출하기"
        android:textColor="#FEFEFE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/pretendard_medium"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout> 