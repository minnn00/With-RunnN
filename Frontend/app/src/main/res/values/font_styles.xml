<?xml version="1.0" encoding="utf-8"?>
<resources
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ~~ Pretendard ~~ -->

    <!-- SemiBold -->
    <style name="Text_Pretendard_SemiBold_18">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text_Pretendard_SemiBold_20">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text_Pretendard_SemiBold_22">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Medium -->
    <style name="Text_Pretendard_Medium_14">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text_Pretendard_Medium_16">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text_Pretendard_Medium_18">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Regular -->
    <style name="Text_Pretendard_Regular_10">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="Text_Pretendard_Regular_11">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Text_Pretendard_Regular_12">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text_Pretendard_Regular_16">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MyPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <!-- 팝업 배경 -->
        <item name="android:popupBackground">@drawable/bg_popup_round</item>
        <item name="android:backgroundTint">@color/gray_050</item>
        <!-- (선택) 그림자 -->
        <item name="android:popupElevation">8dp</item>
        <!-- (선택) 아이템 텍스트 스타일 -->
        <item name="android:textAppearanceLargePopupMenu">@style/MyPopupText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/MyPopupText</item>
    </style>

    <style name="MyPopupText" parent="@style/TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/gray_950</item>
    </style>

</resources>